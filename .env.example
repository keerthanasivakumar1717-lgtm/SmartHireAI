# SmartHireAI Environment Configuration Example
# Copy this file to .env and insert your actual API keys.
# NEVER commit .env to version control.

# Google Gemini API Key (Required for LLM structured parsing, CV suggestions, and RAG mentor)
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
# Supported options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# Embedding Model Configuration
# Options:
# 1) sentence-transformers/all-MiniLM-L6-v2 (local CPU embedding, free, no API quota needed - recommended default)
# 2) models/text-embedding-004 (Google Gemini cloud embedding)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Vector Store and Search Configuration
FAISS_INDEX_DIR=vectorstore
TOP_K_JOBS=5
SIMILARITY_THRESHOLD=0.35

# Data Paths
JOBS_DATASET_PATH=data/jobs/sample_jobs.csv
CAREER_NOTES_DIR=data/career_notes
RESUMES_DIR=data/resumes

